# Sensitive site config (contains DB passwords, encryption keys)
sites/*/site_config.json
archived/sites/*/site_config.json
sites/common_site_config.json

# Logs
logs/
sites/*/logs/
archived/sites/*/logs/

# PID files — ignore the runtime files but track the directory so it survives git clone
config/pids/*.pid
config/pids/*.pid.old

# Claude — ignore settings/cache but track shared agent definitions
.claude/
!.claude/agents/
!.claude/agents/*.md
CLAUDE.md

# Work progress log and internal docs (not for version control)
workprogress.txt
web docs/

# Gameplan app (not tracked in this repo)
apps/gameplan/

# Local-only HRMS themes (kept on this machine, not shared)
apps/hrms/hrms/public/css/uichange*.css
apps/hrms/hrms/public/js/theme_switcher.js

# Compiled/symlinked assets — entire directory is machine-generated by bench build
sites/assets/

# Database backups
sites/*/private/backups/*.sql.gz
sites/*/private/backups/*.sql

# Uploaded public files
sites/*/public/files/*.jpg
sites/*/public/files/*.jpeg
sites/*/public/files/*.png
sites/*/public/files/*.pdf
sites/*/public/files/*.doc
sites/*/public/files/*.docx

# Site runtime/index files
sites/*/indexes/
sites/*/touched_tables.json
sites/*/helpdesk_search.db
sites/*/.test_log

# Backups with credentials
sites/*/private/backups/*site_config_backup*

# Machine-specific bench config (generated per server by bench setup procfile/redis)
Procfile
config/redis_cache.conf
config/redis_queue.conf
config/redis_cache.acl
config/redis_queue.acl

# Python virtual environment (rebuilt per server with bench setup env)
env/

# Python cache
__pycache__/
*.pyc
*.pyo


# Node modules
node_modules/

# Build output
dist/
build/

# OS files
.DS_Store
Thumbs.db
apps/erpnext/erpnext/patches/v16_0/*.Identifier

# Site lock files and uploaded calendar invites
sites/*/locks/
sites/*/private/files/*.ics

# Separate git repos — tracked independently (from hilton-update)
env/

# Local startup script (machine-specific paths)
start-bench.sh

# Windows Zone.Identifier ADS metadata files (created when files downloaded on Windows)
*Zone.Identifier
*:Zone.Identifier

# Unapproved MFT license API (OTP version — not in use)
apps/erpnext/erpnext/mft_license_api.py
