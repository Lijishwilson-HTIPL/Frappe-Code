  "html": "<div style=\"font-family: Arial, Helvetica, sans-serif; padding:20px; color:#222;\">\n  <table style=\"width:100%; border-bottom:2px solid #1a1a1a; padding-bottom:8px;\">\n    <tr>\n      <td><div style=\"font-size:22px; font-weight:800; letter-spacing:1px;\">MERCURY</div></td>\n      <td style=\"text-align:right;\">\n        <div style=\"font-size:16px; font-weight:700;\">Monthly Progress Report</div>\n        <div style=\"font-size:11px; color:#666;\">Generated {{ frappe.utils.formatdate(frappe.utils.nowdate()) }}</div>\n      </td>\n    </tr>\n  </table>\n\n  {% set tasks = frappe.get_all(\"Task\", filters={\"project\": doc.name}, fields=[\"subject\",\"status\",\"progress\"], order_by=\"creation\") %}\n\n  <table style=\"width:100%; font-size:13px; margin:14px 0;\">\n    <tr><td style=\"width:50%;\"><b>Project:</b> {{ doc.project_name }}</td>\n        <td><b>Customer:</b> {{ doc.customer or \"—\" }}</td></tr>\n    <tr><td><b>Status:</b> {{ doc.status }}</td>\n        <td><b>Expected End:</b> {{ frappe.utils.formatdate(doc.expected_end_date) if doc.expected_end_date else \"—\" }}</td></tr>\n  </table>\n\n  <div style=\"margin:10px 0 18px;\">\n    <div style=\"font-size:13px; margin-bottom:4px;\"><b>Overall Completion: {{ doc.percent_complete | round(0) | int }}%</b></div>\n    <div style=\"height:14px; background:#eee; border-radius:8px; overflow:hidden;\">\n      <div style=\"height:100%; width:{{ doc.percent_complete }}%; background:#2f7d3a;\"></div>\n    </div>\n  </div>\n\n  <table style=\"width:100%; border-collapse:collapse; font-size:12px;\">\n    <thead>\n      <tr style=\"background:#f2f2f2;\">\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:left;\">#</th>\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:left;\">Manufacturing Stage</th>\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:left;\">Status</th>\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:left; width:35%;\">Progress</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for t in tasks %}\n      <tr>\n        <td style=\"border:1px solid #bbb; padding:6px;\">{{ loop.index }}</td>\n        <td style=\"border:1px solid #bbb; padding:6px;\">{{ t.subject }}</td>\n        <td style=\"border:1px solid #bbb; padding:6px;\">{{ t.status }}</td>\n        <td style=\"border:1px solid #bbb; padding:6px;\">\n          <div style=\"height:10px; background:#eee; border-radius:5px; overflow:hidden; display:inline-block; width:70%; vertical-align:middle;\">\n            <div style=\"height:100%; width:{{ t.progress }}%; background:#3a7bd5;\"></div>\n          </div>\n          <span style=\"font-size:11px;\">&nbsp;{{ t.progress | round(0) | int }}%</span>\n        </td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div style=\"margin-top:14px; font-size:11px; color:#666;\">\n    Auto-generated from live project data &middot; Mercury Manufacturing &middot; Ex-Works\n  </div>\n</div>",
