  "format_data": null,
  "html": "{#- Mercury Shipping & Packing Label — ONE LABEL PER PHYSICAL UNIT (per serial no).\n    Page 1 = shipment manifest, then one full label page per component unit. -#}\n\n{%- set ns = namespace(all=[]) -%}\n{%- for item in doc.items -%}\n  {%- set raw = (item.serial_no or (get_serial_or_batch_nos(item.serial_and_batch_bundle) if item.serial_and_batch_bundle else \"\")) | replace(\",\", \"\\n\") -%}\n  {%- set snos = raw.split(\"\\n\") | map(\"trim\") | reject(\"equalto\", \"\") | list -%}\n  {%- if snos -%}\n    {%- for sr in snos -%}\n      {%- set _ = ns.all.append({\"item\": item, \"sr\": sr, \"n\": loop.index, \"of\": snos|length}) -%}\n    {%- endfor -%}\n  {%- else -%}\n    {#- non-serialised line: one label for the whole lot -#}\n    {%- set _ = ns.all.append({\"item\": item, \"sr\": None, \"n\": 1, \"of\": 1}) -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- set total = ns.all | length -%}\n{%- set logo = \"/assets/mercury/images/mercury_logo.png\" -%}\n{#- single source of truth for logo size — used identically on the manifest and every label -#}\n{%- set logo_w = 106 -%}\n\n<!-- ============ PAGE 1 : SHIPMENT MANIFEST ============ -->\n<div style=\"font-family: Arial, Helvetica, sans-serif; border:2px solid #1a1a1a; padding:18px; page-break-after: always;\">\n  <table style=\"width:100%; border-collapse:collapse;\">\n    <tr>\n      <td style=\"vertical-align:top;\">\n        {#- Frappe's print style forces `.print-format td img { width:100% !important }`\n            (legacy mozilla table hack), which overrides any inline width on the image.\n            Wrapping in a fixed-width box makes that 100% resolve to logo_w, so the\n            preview and the generated PDF render identically. -#}\n        <div style=\"width:{{ logo_w }}px; max-width:{{ logo_w }}px;\">\n          <img src=\"{{ logo }}\" alt=\"MERCURY\" style=\"width:100%; height:auto; display:block;\">\n        </div>\n        <div style=\"font-size:12px; letter-spacing:2px; color:#666; margin-top:8px;\">SHIPMENT MANIFEST</div>\n      </td>\n      <td style=\"text-align:right; vertical-align:top; font-size:13px;\">\n        <div><b>Delivery Note:</b> {{ doc.name }}</div>\n        <div><b>Date:</b> {{ doc.get_formatted(\"posting_date\") }}</div>\n        <div><b>Customer:</b> {{ doc.customer_name }}</div>\n        <div><b>Customer PO:</b> {{ doc.po_no or \"—\" }}</div>\n        <div style=\"margin-top:6px; font-size:18px; font-weight:800;\">{{ total }} LABELLED UNIT{{ \"S\" if total != 1 else \"\" }}</div>\n      </td>\n    </tr>\n  </table>\n  <hr style=\"border:none; border-top:1px solid #ccc; margin:12px 0;\">\n  <table style=\"width:100%; border-collapse:collapse; font-size:12px;\">\n    <thead>\n      <tr style=\"background:#f2f2f2;\">\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:left; width:8%;\">Label</th>\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:left;\">Component</th>\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:left; width:20%;\">Serial No</th>\n        <th style=\"border:1px solid #bbb; padding:6px; text-align:center; width:14%;\">Unit</th>\n      </tr>\n    </thead>\n    <tbody>\n      {%- for u in ns.all %}\n      <tr>\n        <td style=\"border:1px solid #bbb; padding:6px;\"><b>{{ loop.index }}/{{ total }}</b></td>\n        <td style=\"border:1px solid #bbb; padding:6px;\">{{ u.item.item_name }} <span style=\"color:#888;\">({{ u.item.item_code }})</span></td>\n        <td style=\"border:1px solid #bbb; padding:6px; font-family: 'Courier New', monospace;\">{{ u.sr or \"—\" }}</td>\n        <td style=\"border:1px solid #bbb; padding:6px; text-align:center;\">{{ u.n }} of {{ u.of }}</td>\n      </tr>\n      {%- endfor %}\n    </tbody>\n  </table>\n  <div style=\"margin-top:12px; font-size:11px; color:#666;\">\n    Ex-Works &middot; Each unit below carries its own QR label. Please scan and acknowledge <b>every one of the {{ total }} units</b> on receipt.\n  </div>\n</div>\n\n<!-- ============ ONE LABEL PER UNIT ============ -->\n{%- for u in ns.all %}\n{%- set payload = frappe.get_url() ~ \"/shipment-ack?dn=\" ~ doc.name ~ \"&item=\" ~ u.item.item_code ~ \"&sr=\" ~ (u.sr or \"\") -%}\n<div style=\"font-family: Arial, Helvetica, sans-serif; border:2px solid #1a1a1a; padding:18px;{% if not loop.last %} page-break-after: always;{% endif %}\">\n\n  <table style=\"width:100%; border-collapse:collapse;\">\n    <tr>\n      <td style=\"vertical-align:top;\">\n        {#- Frappe's print style forces `.print-format td img { width:100% !important }`\n            (legacy mozilla table hack), which overrides any inline width on the image.\n            Wrapping in a fixed-width box makes that 100% resolve to logo_w, so the\n            preview and the generated PDF render identically. -#}\n        <div style=\"width:{{ logo_w }}px; max-width:{{ logo_w }}px;\">\n          <img src=\"{{ logo }}\" alt=\"MERCURY\" style=\"width:100%; height:auto; display:block;\">\n        </div>\n        <div style=\"font-size:12px; letter-spacing:2px; color:#666; margin-top:8px;\">SHIPPING &amp; PACKING LABEL</div>\n      </td>\n      <td style=\"text-align:right; vertical-align:top;\">\n        <div style=\"display:inline-block; border:1px solid #1a1a1a; padding:4px 10px; font-size:14px; font-weight:800;\">\n          LABEL {{ loop.index }} OF {{ total }}\n        </div>\n      </td>\n    </tr>\n  </table>\n\n  <hr style=\"border:none; border-top:1px solid #ccc; margin:12px 0;\">\n\n  <!-- component identity + its own QR -->\n  <table style=\"width:100%; border-collapse:collapse;\">\n    <tr>\n      <td style=\"vertical-align:top;\">\n        <div style=\"font-size:10px; letter-spacing:1.5px; color:#888;\">COMPONENT</div>\n        <div style=\"font-size:22px; font-weight:800; line-height:1.2; margin-top:2px;\">{{ u.item.item_name }}</div>\n        <div style=\"font-size:12px; color:#888; margin-top:2px;\">{{ u.item.item_code }}</div>\n\n        <div style=\"margin-top:14px; font-size:10px; letter-spacing:1.5px; color:#888;\">SERIAL NO</div>\n        <div style=\"font-family:'Courier New', monospace; font-size:26px; font-weight:800; letter-spacing:2px;\">{{ u.sr or \"—\" }}</div>\n\n        <div style=\"margin-top:14px; font-size:13px;\">\n          <b>Unit {{ u.n }} of {{ u.of }}</b> of this component\n          &nbsp;&middot;&nbsp; Qty on label: <b>1</b>\n        </div>\n      </td>\n      <td style=\"text-align:right; vertical-align:top; width:170px;\">\n        <img src=\"data:image/png;base64,{{ qr_base64(payload) }}\" style=\"width:150px; height:150px;\">\n        <div style=\"font-size:9px; color:#666; margin-top:2px;\">Scan to acknowledge<br>THIS component</div>\n      </td>\n    </tr>\n  </table>\n\n  <hr style=\"border:none; border-top:1px solid #ccc; margin:12px 0;\">\n\n  <table style=\"width:100%; font-size:13px;\">\n    <tr>\n      <td style=\"width:55%; padding:3px 0;\"><b>Delivery Note:</b> {{ doc.name }}</td>\n      <td style=\"padding:3px 0;\"><b>Date:</b> {{ doc.get_formatted(\"posting_date\") }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:3px 0;\"><b>Customer:</b> {{ doc.customer_name }}</td>\n      <td style=\"padding:3px 0;\"><b>Customer PO:</b> {{ doc.po_no or \"—\" }}</td>\n    </tr>\n  </table>\n\n  <div style=\"margin-top:12px; font-size:11px; color:#666;\">\n    Ex-Works &middot; This label identifies <b>one physical unit</b>. Shipment contains <b>{{ total }} labelled units</b> in total.\n  </div>\n</div>\n{%- endfor %}\n",
