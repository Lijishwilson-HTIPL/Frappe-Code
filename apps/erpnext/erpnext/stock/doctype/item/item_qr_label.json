 "font": "Default",
 "html": "<style>\n  .qr-label-wrapper {\n    width: 7cm;\n    padding: 8px;\n    border: 1px solid #ccc;\n    border-radius: 6px;\n    text-align: center;\n    font-family: sans-serif;\n    page-break-inside: avoid;\n  }\n  .qr-label-wrapper img {\n    width: 5cm;\n    height: 5cm;\n    object-fit: contain;\n  }\n  .qr-item-code {\n    font-size: 14px;\n    font-weight: bold;\n    margin-top: 6px;\n    word-break: break-all;\n  }\n  .qr-item-name {\n    font-size: 12px;\n    color: #555;\n    margin: 2px 0;\n  }\n  .qr-uom {\n    font-size: 11px;\n    color: #888;\n  }\n  @media print {\n    body { margin: 0; }\n    .qr-label-wrapper { border-color: #999; }\n  }\n</style>\n\n<div class=\"qr-label-wrapper\">\n  {% if doc.qr_code %}\n    <img src=\"{{ doc.qr_code }}\" alt=\"QR Code\"/>\n  {% else %}\n    <p style=\"color:red;font-size:11px;\">QR Code not generated.<br>Click Actions &rarr; Generate QR Code first.</p>\n  {% endif %}\n  <div class=\"qr-item-code\">{{ doc.item_code }}</div>\n  {% if doc.item_name and doc.item_name != doc.item_code %}\n    <div class=\"qr-item-name\">{{ doc.item_name }}</div>\n  {% endif %}\n  <div class=\"qr-uom\">{{ doc.stock_uom }}</div>\n</div>",
